#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

WORK=/root/tianxian-restore
BOOT=/root/tianxian-bootstrap
TOOLS=/root/tianxian-recovery-tools
TARGET=/opt/TianXian-Server
KEY=/root/.tianxian-backup-key
R2ENV=/root/.tianxian-r2.env
VENV=/opt/tianxian-recovery-venv
DEFAULT_BACKEND_PORT=18080
DEFAULT_WEB_PORT=3800
BACKEND_PORT=$DEFAULT_BACKEND_PORT
WEB_PORT=$DEFAULT_WEB_PORT
WEB_TARGET=/opt/TianXian-Web
WEB_INCLUDED=0
MANAGER_URL='https://raw.githubusercontent.com/sockc/TianXianFruit/main/server-tools/backup-manager/tianxian-manager'
RESTORE_URL='https://raw.githubusercontent.com/sockc/TianXianFruit/main/server-tools/txb-web/tianxian-restore'
BACKUP_URL='https://raw.githubusercontent.com/sockc/TianXianFruit/main/server-tools/txb-web/tianxian-backup'
R2_KEY_OVERRIDE=''
BACKEND_BIND='127.0.0.1'
WEB_BIND='127.0.0.1'

die(){ echo "✗ $*" >&2; exit 1; }
step(){ echo; echo "[$1/8] $2"; }
usage() {
  cat <<'USAGE'
用法：tianxian-recover [--r2-key 完整R2对象路径]

--r2-key  从 R2 精确恢复指定 TXB；省略时选择最新备份。
监听地址在解密并校验 TXB 后交互选择。
多个 IPv4 地址使用英文逗号分隔，例如 127.0.0.1,192.168.6.1。
0.0.0.0 必须单独使用，会监听所有 IPv4 网卡。
USAGE
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --r2-key) [[ $# -ge 2 && -n "$2" ]] || die "--r2-key 缺少对象路径"; R2_KEY_OVERRIDE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "未知参数：$1" ;;
  esac
done
[[ ${EUID:-$(id -u)} -eq 0 ]] || die '请使用 root 运行。'


# 默认直接在当前 SSH 会话中运行。
# 不自动使用 tmux，避免旧会话/死 pane 导致误进入上一次恢复现场。
RECOVER_LOG=/var/log/tianxian-recover.log
mkdir -p /var/log
touch "$RECOVER_LOG"
chmod 600 "$RECOVER_LOG"
exec > >(tee -a "$RECOVER_LOG") 2>&1
echo
echo "===== TianXian recovery start: $(date '+%F %T %z') ====="

[[ ! -e "$TARGET" ]] || die "$TARGET 已存在；裸机恢复拒绝覆盖现有 Server。"

setup_credentials(){
  if [[ ! -s "$KEY" ]]; then
    local backup_key
    read -r -s -p '原 .backup-key（64位十六进制，输入不显示）：' backup_key
    echo
    [[ "$backup_key" =~ ^[0-9A-Fa-f]{64}$ ]] || die 'backup-key 格式错误。'
    printf '%s\n' "$backup_key" > "$KEY"
    unset backup_key
  fi

  if [[ ! -s "$R2ENV" ]]; then
    local endpoint bucket prefix access_key secret_key
    read -r -p 'R2_ENDPOINT（完整 https://...r2.cloudflarestorage.com 地址）：' endpoint
    read -r -p 'R2_BUCKET [tianxian]：' bucket
    bucket="${bucket:-tianxian}"
    read -r -p 'R2_PREFIX [tianxian-backups]：' prefix
    prefix="${prefix:-tianxian-backups}"
    read -r -s -p 'R2 Access Key ID（输入不显示）：' access_key
    echo
    read -r -s -p 'R2 Secret Access Key（输入不显示）：' secret_key
    echo
    [[ -n "$endpoint" && -n "$access_key" && -n "$secret_key" ]] || die 'R2 配置不能为空。'
    cat > "$R2ENV" <<EOF_R2
R2_ENDPOINT='$endpoint'
R2_BUCKET='$bucket'
R2_PREFIX='$prefix'
AWS_ACCESS_KEY_ID='$access_key'
AWS_SECRET_ACCESS_KEY='$secret_key'
EOF_R2
    unset endpoint bucket prefix access_key secret_key
  fi

  chmod 600 "$KEY" "$R2ENV"
  local compact_key
  compact_key="$(tr -d '\r\n[:space:]' < "$KEY")"
  [[ "$compact_key" =~ ^[0-9A-Fa-f]{64}$ ]] || die "$KEY 中不是有效 backup-key。"
}

setup_credentials
# shellcheck disable=SC1090
source "$R2ENV"
: "${R2_ENDPOINT:?R2_ENDPOINT 未配置}"
: "${R2_BUCKET:?R2_BUCKET 未配置}"
: "${R2_PREFIX:?R2_PREFIX 未配置}"
: "${AWS_ACCESS_KEY_ID:?AWS_ACCESS_KEY_ID 未配置}"
: "${AWS_SECRET_ACCESS_KEY:?AWS_SECRET_ACCESS_KEY 未配置}"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION=auto AWS_EC2_METADATA_DISABLED=true

read -r -p '确认这是全新服务器，输入 RECOVER 开始恢复：' x
[[ "$x" == RECOVER ]] || die '已取消。'

step 1 '安装恢复环境'
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y ca-certificates curl openssl tar gzip python3 python3-venv python3-pip util-linux
if ! command -v docker >/dev/null || ! docker compose version >/dev/null 2>&1; then
  curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  sh /tmp/get-docker.sh
  rm -f /tmp/get-docker.sh
fi
systemctl enable --now docker >/dev/null 2>&1 || true
if [[ ! -x "$VENV/bin/aws" ]]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip awscli
fi

step 2 '下载 R2 最新加密 TXB'
mkdir -p "$WORK"
AWS="$VENV/bin/aws"
if [[ -n "$R2_KEY_OVERRIDE" ]]; then
  [[ "$R2_KEY_OVERRIDE" == "$R2_PREFIX/"* && "$R2_KEY_OVERRIDE" == *.txb.enc ]] ||
    die "--r2-key 必须是 $R2_PREFIX/ 下的 .txb.enc 对象"
  [[ "$R2_KEY_OVERRIDE" != *'..'* ]] || die "R2 Key 含无效路径片段"
  REMOTE="$R2_KEY_OVERRIDE"
else
  LIST="$($AWS s3 ls "s3://${R2_BUCKET}/${R2_PREFIX}/" --recursive --endpoint-url "$R2_ENDPOINT")"
  REMOTE="$(printf '%s\n' "$LIST" | awk '$4 ~ /\.txb\.enc$/ {print $1" "$2" "$4}' | sort -r | head -1 | cut -d' ' -f3-)"
  [[ -n "$REMOTE" ]] || die 'R2 中没有找到 .txb.enc'
fi
echo "最新备份：$REMOTE"
$AWS s3 cp "s3://${R2_BUCKET}/${REMOTE}" "$WORK/latest.txb.enc" --endpoint-url "$R2_ENDPOINT"
sha256sum "$WORK/latest.txb.enc" | tee "$WORK/latest.txb.enc.sha256"

step 3 '解密并检查 TXB'
openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 \
  -in "$WORK/latest.txb.enc" \
  -out "$WORK/latest.txb" \
  -pass file:"$KEY"
tar -tzf "$WORK/latest.txb" >/dev/null || die '解密结果不是有效 TXB，请检查 backup-key。'

step 4 '提取 TXB 内置 Server 恢复工具'
rm -rf "$BOOT" "$TOOLS"
mkdir -p "$BOOT" "$TOOLS"
tar -xzf "$WORK/latest.txb" -C "$BOOT"
if [[ -f "$BOOT/checksums/SHA256SUMS" ]]; then
  (cd "$BOOT" && sha256sum -c checksums/SHA256SUMS)
fi
[[ -f "$BOOT/server/server-release.tar.gz" ]] || die 'TXB 缺少 server/server-release.tar.gz'
tar -xzf "$BOOT/server/server-release.tar.gz" -C "$TOOLS"
chmod +x "$TOOLS/tianxian-restore" "$TOOLS/scripts/tianxian-restore" 2>/dev/null || true
[[ -x "$TOOLS/tianxian-restore" ]] || die '没有找到 tianxian-restore'
[[ -f "$TOOLS/scripts/tianxian-restore" ]] || die 'TXB Server 快照中缺少恢复脚本。'

# Old TXBs cannot contain later listener-address features. Apply the tested
# current restore tool to the extracted snapshot before any DB is modified.
RESTORER_DOWNLOAD="$(mktemp "$WORK/tianxian-restore.XXXXXX")"
curl -fsSL "$RESTORE_URL" -o "$RESTORER_DOWNLOAD" || die '无法取得新版恢复工具，尚未执行数据恢复。'
bash -n "$RESTORER_DOWNLOAD" || die '新版恢复工具语法检查失败。'
install -m 0755 "$RESTORER_DOWNLOAD" "$TOOLS/scripts/tianxian-restore"
rm -f "$RESTORER_DOWNLOAD"
echo '✓ 已装载支持多监听地址的新版恢复器。'

validate_port(){
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( port >= 1 && port <= 65535 ))
}

# Check exact requested IPv4 addresses, local ownership and host port
# availability. Echo canonical comma-separated addresses on success.
check_listeners(){
  local label="$1" ips="$2" port="$3"
  python3 - "$label" "$ips" "$port" <<'PY_CHECK'
import ipaddress
import socket
import sys

label, raw, port_string = sys.argv[1:]
try:
    port = int(port_string)
    if not 1 <= port <= 65535:
        raise ValueError("端口必须在 1-65535 之间")
    addresses = [part.strip() for part in raw.split(",")]
    if not addresses or any(not part for part in addresses):
        raise ValueError("监听地址不能为空，请用英文逗号分隔")
    addresses = [str(ipaddress.IPv4Address(part)) for part in addresses]
    if len(set(addresses)) != len(addresses):
        raise ValueError("监听地址重复")
    if "0.0.0.0" in addresses and len(addresses) > 1:
        raise ValueError("0.0.0.0 代表所有 IPv4 地址，不能与其他地址混用")
    for ip in addresses:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind((ip, port))
            except OSError as exc:
                raise ValueError(
                    f"{ip}:{port} 无法监听（地址不属于 EQ 或端口被占用）：{exc}"
                ) from exc
    print(",".join(addresses))
except (ValueError, ipaddress.AddressValueError) as exc:
    print(f"{label}: {exc}", file=sys.stderr)
    sys.exit(1)
PY_CHECK
}

prompt_listener(){
  local label="$1" default_ips="$2" port="$3" chosen=""
  while true; do
    read -r -p "$label 监听地址 [$default_ips]（多个地址用英文逗号）： " chosen
    chosen="${chosen:-$default_ips}"
    local normalized=""
    if ! normalized="$(check_listeners "$label" "$chosen" "$port")"; then
      echo '! 地址或端口不正确，请重新输入。' >&2
      continue
    fi
    if [[ "$normalized" == '0.0.0.0' ]]; then
      echo '! 警告：0.0.0.0 会监听所有 IPv4 网卡，可能暴露在公网；需额外配置防火墙。' >&2
      local confirm_public=""
      read -r -p '确认开放监听请输入 EXPOSE，否则重新选择：' confirm_public
      [[ "$confirm_public" == EXPOSE ]] || continue
    fi
    printf '%s\n' "$normalized"
    return 0
  done
}

health_host(){
  local ips="$1"
  case ",$ips," in
    *,127.0.0.1,*|*,0.0.0.0,*) printf '127.0.0.1\n' ;;
    *) printf '%s\n' "${ips%%,*}" ;;
  esac
}

# Read optional port/Web metadata from the TXB before starting services.
if [[ -f "$BOOT/metadata/manifest.env" ]]; then
  # shellcheck disable=SC1090
  source "$BOOT/metadata/manifest.env"
fi
# Backup host addresses/ports are historical metadata. Never adopt them as
# restore defaults: the destination machine may have different interfaces.
# Prefer loopback so a fresh recovery is not exposed before DNS/Lucky cutover.
DEFAULT_BACKEND_BIND='127.0.0.1'
DEFAULT_BACKEND_PORT=18080
if [[ -f "$BOOT/web/web-metadata.env" ]]; then
  # shellcheck disable=SC1090
  source "$BOOT/web/web-metadata.env"
fi
if [[ -f "$BOOT/web/web-release.tar.gz" ]]; then
  WEB_INCLUDED=1
fi

echo
echo "备份来源 Server 监听：${BACKEND_BIND_LIST:-${BACKEND_BIND:-未知}}（原端口 ${BACKEND_HOST_PORT:-未知}，仅供参考）"
if [[ "$WEB_INCLUDED" -eq 1 ]]; then
  echo "备份来源 Web 监听：${WEB_BIND_LIST:-未知}（原端口 ${WEB_HOST_PORT:-未知}，仅供参考）"
fi
echo '恢复默认：Server 127.0.0.1:18080；Web 127.0.0.1:3800。'

echo
while true; do
  read -r -p "Server 后端端口 [$DEFAULT_BACKEND_PORT]： " BACKEND_PORT
  BACKEND_PORT="${BACKEND_PORT:-$DEFAULT_BACKEND_PORT}"
  if validate_port "$BACKEND_PORT"; then break; fi
  echo '! 端口必须为 1-65535，请重新输入。'
done
BACKEND_BIND="$(prompt_listener 'Server' "$DEFAULT_BACKEND_BIND" "$BACKEND_PORT")"
echo "✓ Server 绑定：$BACKEND_BIND:$BACKEND_PORT"

if [[ "$WEB_INCLUDED" -eq 1 ]]; then
  while true; do
    read -r -p "Web 端口 [$DEFAULT_WEB_PORT]： " WEB_PORT
    WEB_PORT="${WEB_PORT:-$DEFAULT_WEB_PORT}"
    if validate_port "$WEB_PORT"; then break; fi
    echo '! 端口必须为 1-65535，请重新输入。'
  done
  while true; do
    WEB_BIND="$(prompt_listener 'Web' '127.0.0.1' "$WEB_PORT")"
    if [[ "$WEB_PORT" == "$BACKEND_PORT" ]]; then
      if [[ "$BACKEND_BIND" == '0.0.0.0' || "$WEB_BIND" == '0.0.0.0' ]]; then
        echo '! Server/Web 的通配地址不能共用相同端口，请修改 Web 地址或端口。'
        continue
      fi
      IFS=',' read -r -a backend_addrs <<<"$BACKEND_BIND"
      IFS=',' read -r -a web_addrs <<<"$WEB_BIND"
      conflict=0
      for b in "${backend_addrs[@]}"; do
        for w in "${web_addrs[@]}"; do
          [[ "$b" == "$w" ]] && conflict=1
        done
      done
      if [[ "$conflict" -eq 1 ]]; then
        echo '! Server/Web 有重复监听地址且端口相同，请更改 Web 地址或端口。'
        continue
      fi
    fi
    break
  done
  echo "✓ Web 绑定：$WEB_BIND:$WEB_PORT"
  echo
  echo 'Web 与恢复后的 Server 如何连接：'
  echo '1. 自动使用私有 Docker 网络（推荐，默认，不依赖宿主机 IP）'
  echo '2. 保留备份中的 API 地址（仅在正式域名已切换到新服务器时使用）'
  echo '3. 指定其他 API 地址（HTTP/HTTPS）'
  read -r -p '请选择 [1]： ' web_api_choice
  case "${web_api_choice:-1}" in
    1) WEB_API_MODE=internal ;;
    2) WEB_API_MODE=preserve ;;
    3)
      WEB_API_MODE=custom
      read -r -p '新 Web API 地址（例如 https://test-sync.example.com）： ' WEB_API_URL
      [[ -n "$WEB_API_URL" ]] || die '自定义 Web API 地址不能为空'
      ;;
    *) die '无效选择，已取消恢复。' ;;
  esac
else
  WEB_PORT="$DEFAULT_WEB_PORT"
  echo 'ℹ 此 TXB 未包含 Web，跳过 Web 端口选择。'
fi

step 5 '执行正式恢复'
if [[ -f "$TOOLS/tianxian-backup-check" ]]; then
  chmod +x "$TOOLS/tianxian-backup-check"
  "$TOOLS/tianxian-backup-check" "$WORK/latest.txb" --password-file "$KEY"
fi

RESTORE_HELP="$("$TOOLS/tianxian-restore" --help 2>&1 || true)"
printf '%s' "$RESTORE_HELP" | grep -q -- '--backend-bind' ||
  die '新版恢复器缺少 --backend-bind，拒绝继续恢复。'
RESTORE_ARGS=("$WORK/latest.txb"
  --password-file "$KEY"
  --target "$TARGET"
  --backend-port "$BACKEND_PORT"
  --backend-bind "$BACKEND_BIND")
if [[ "$WEB_INCLUDED" -eq 1 ]]; then
  RESTORE_ARGS+=(--web-target "$WEB_TARGET" --web-port "$WEB_PORT" --web-bind "$WEB_BIND")
  case "${WEB_API_MODE:-internal}" in
    preserve) RESTORE_ARGS+=(--keep-web-api) ;;
    custom) RESTORE_ARGS+=(--web-api-url "$WEB_API_URL") ;;
  esac
fi
"$TOOLS/tianxian-restore" "${RESTORE_ARGS[@]}"

# Persist the tested recovery tools inside the restored Server, not just in
# /root bootstrap, so the next TXB and future Manager restores support IP lists.
install -m 0755 "$TOOLS/scripts/tianxian-restore" "$TARGET/scripts/tianxian-restore"
BACKUP_DOWNLOAD="$(mktemp "$WORK/tianxian-backup.XXXXXX")"
curl -fsSL "$BACKUP_URL" -o "$BACKUP_DOWNLOAD" || die '恢复已完成，但无法取得新版 TXB 备份工具。'
bash -n "$BACKUP_DOWNLOAD" || die '新版备份工具语法校验失败。'
install -m 0755 "$BACKUP_DOWNLOAD" "$TARGET/scripts/tianxian-backup"
rm -f "$BACKUP_DOWNLOAD"
echo '✓ 新版备份/恢复工具已安装到恢复后的 Server。'

step 6 '恢复 key 与 R2 配置'
install -m 0600 "$KEY" "$TARGET/.backup-key"

R2_ACCOUNT_ID="${R2_ENDPOINT#https://}"
R2_ACCOUNT_ID="${R2_ACCOUNT_ID#http://}"
R2_ACCOUNT_ID="${R2_ACCOUNT_ID%%.*}"
[[ -n "$R2_ACCOUNT_ID" ]] || die '无法从 R2_ENDPOINT 提取 Account ID。'

export R2_ACCOUNT_ID R2_ENDPOINT R2_BUCKET R2_PREFIX AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
python3 - "$TARGET/.r2.env" <<'PY_R2'
import os
import shlex
import sys
from pathlib import Path

path = Path(sys.argv[1])
values = {
    "R2_ACCOUNT_ID": os.environ["R2_ACCOUNT_ID"],
    "R2_ENDPOINT": os.environ["R2_ENDPOINT"],
    "R2_ACCESS_KEY_ID": os.environ["AWS_ACCESS_KEY_ID"],
    "R2_SECRET_ACCESS_KEY": os.environ["AWS_SECRET_ACCESS_KEY"],
    "R2_BUCKET": os.environ["R2_BUCKET"],
    "R2_PREFIX": os.environ["R2_PREFIX"],
    # Compatibility aliases for bootstrap/AWS CLI based tooling.
    "AWS_ACCESS_KEY_ID": os.environ["AWS_ACCESS_KEY_ID"],
    "AWS_SECRET_ACCESS_KEY": os.environ["AWS_SECRET_ACCESS_KEY"],
}
path.write_text(
    "".join(f"{key}={shlex.quote(value)}\n" for key, value in values.items()),
    encoding="utf-8",
)
PY_R2
chmod 600 "$TARGET/.r2.env"
echo '✓ 已复用首次输入的 R2 参数生成正式 .r2.env，无需再次输入。'

if [[ -x "$TARGET/tianxian-r2-test" ]]; then
  if ! (cd "$TARGET" && ./tianxian-r2-test); then
    echo '生成的 R2 配置字段：'
    sed 's/=.*$/=<hidden>/' "$TARGET/.r2.env"
    die 'R2 自动配置测试失败。可恢复后运行 tianxian → 配置管理 → 配置/修改 R2。'
  fi
else
  die '恢复后的 Server 缺少 tianxian-r2-test'
fi

echo 'ℹ 自动备份任务默认不安装；正式服务器可在 tianxian → 配置管理 → 自动备份管理中启用。'

step 7 '安装日常管理命令'
manager_download="$(mktemp /usr/local/sbin/tianxian.XXXXXX)"
curl -fsSL "$MANAGER_URL" -o "$manager_download"
bash -n "$manager_download"
chmod 0755 "$manager_download"
mv -f "$manager_download" /usr/local/sbin/tianxian
mkdir -p /etc/tianxian-manager
chmod 700 /etc/tianxian-manager
cat >/etc/tianxian-manager/config.env <<EOF2
SERVER_DIR='$TARGET'
DOMAIN='sync.830888.xyz'
RESTORE_TARGET='$TARGET'
BACKUP_KEY='$TARGET/.backup-key'
BACKEND_PORT='$BACKEND_PORT'
BACKEND_BIND='$BACKEND_BIND'
WEB_BIND='$WEB_BIND'
WEB_DIR='$WEB_TARGET'
WEB_PORT='$WEB_PORT'
EOF2
chmod 600 /etc/tianxian-manager/config.env

step 8 '健康检查'
(cd "$TARGET" && docker compose ps)
HEALTH=''
for _ in $(seq 1 30); do
  HEALTH="$(curl -fsS --max-time 3 "http://$(health_host "$BACKEND_BIND"):$BACKEND_PORT/health" 2>/dev/null || true)"
  [[ -n "$HEALTH" ]] && break
  sleep 2
done
[[ -n "$HEALTH" ]] || die '恢复完成，但 /health 未通过。'
echo "$HEALTH"

if [[ "$WEB_INCLUDED" -eq 1 ]]; then
  WEB_OK=0
  for _ in $(seq 1 30); do
    if curl -fsS --max-time 3 -o /dev/null "http://$(health_host "$WEB_BIND"):$WEB_PORT/" 2>/dev/null; then
      WEB_OK=1
      break
    fi
    sleep 2
  done
  [[ "$WEB_OK" -eq 1 ]] || die "恢复完成，但 Web 端口 $WEB_PORT 健康检查未通过。"
  echo "✓ Web 健康：127.0.0.1:$WEB_PORT"
fi
echo

AUTO_BACKUP_ENABLED=0
read -r -p '是否开启 TianXian 自动备份？[y/N]：' enable_backup
case "${enable_backup:-N}" in
  y|Y|yes|YES|Yes)
    if [[ -x "$TARGET/scripts/install-txb-cron.sh" ]]; then
      (cd "$TARGET" && ./scripts/install-txb-cron.sh)
      AUTO_BACKUP_ENABLED=1
      echo '✓ 自动备份已开启。'
    else
      echo '! 未找到自动备份安装脚本，暂未开启。'
    fi
    ;;
  *)
    echo 'ℹ 自动备份未开启；以后可在 tianxian → 配置管理 → 自动备份管理中启用。'
    ;;
esac

echo
echo '✓ 天鲜账本裸机恢复完成。'
echo '✓ R2 已复用首次输入参数完成配置。'
echo "✓ Backend：$BACKEND_BIND（端口 $BACKEND_PORT）"
if [[ "$WEB_INCLUDED" -eq 1 ]]; then
  echo "✓ Web：已恢复到 $WEB_TARGET；监听 $WEB_BIND（端口 $WEB_PORT）"
  echo "✓ Web API 连接模式：${WEB_API_MODE:-internal}"
else
  echo '✓ Web：此备份未包含，已跳过'
fi
if [[ "$AUTO_BACKUP_ENABLED" -eq 1 ]]; then
  echo '✓ 自动备份：已开启。'
else
  echo '✓ 自动备份：未开启。'
